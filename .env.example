# ===================================
# VibeCraft Environment Variables
# ===================================
# Copy this file to .env and fill in your values

# --- Supabase (Required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend (VITE_ prefix = safe for browser, public keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- AI Provider Keys (Server-side only, NEVER exposed to browser) ---
# At least one provider key is required for AI features
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AIza...

# Default model when user hasn't selected one
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- API Key Encryption ---
# Used to encrypt user-provided API keys stored in the database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=your-random-32-byte-hex-string

# --- Deployment / Publishing ---
# The root domain for subdomain-based project publishing
# User projects will be served at <subdomain>.<DEPLOY_DOMAIN>
DEPLOY_DOMAIN=yourdomain.com

# --- CORS ---
# Allowed origin for the frontend (dev: http://localhost:5173, prod: https://yourdomain.com)
CORS_ORIGIN=http://localhost:5173

# --- API URL ---
# Dev: http://localhost:3001 | Prod: leave empty (same origin)
VITE_API_URL=http://localhost:3001

# --- Server ---
PORT=3001
NODE_ENV=development
